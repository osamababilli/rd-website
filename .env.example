# Public URL of the site (used for canonical links, hreflang, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://rdgrouptr.com

# Quote-form emails are sent over SMTP
SMTP_HOST=mail.rdgrouptr.com
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
# Optional: force true/false; by default true only on port 465
SMTP_SECURE=
SMTP_USER=website@rdgrouptr.com
SMTP_PASS=
# Where new briefs are delivered (comma-separated for several addresses)
CONTACT_TO_EMAIL=
# Sender shown on the email; usually must be the same mailbox as SMTP_USER
CONTACT_FROM_EMAIL=RD Group Website <website@rdgrouptr.com>
