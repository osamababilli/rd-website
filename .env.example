# Public URL of the site (used for canonical links, hreflang, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://rdgrouptr.com

# Quote-form emails are sent through Resend (https://resend.com)
RESEND_API_KEY=
# Where new briefs are delivered (comma-separated for several addresses)
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend
CONTACT_FROM_EMAIL=RD Group Website <website@rdgrouptr.com>
